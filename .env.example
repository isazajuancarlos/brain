# =============================================================================
# QUANTUM UNIFIED BOT V1.0 — CONFIGURACIÓN
# Copiar a .env y editar con valores reales. NUNCA commitear .env.
# Defaults entre paréntesis. Ver bot.txt para semántica completa.
# =============================================================================

# -----------------------------------------------------------------------------
# SISTEMA / RIESGO COMÚN
# -----------------------------------------------------------------------------
KILL_SWITCH=false
MAX_DAILY_LOSS_PCT=3.0
LIQ_BUFFER_PCT=5.0
SL_CONFIRMATION_MINUTES=3
WALLET_BRIDGE_MIN_USDT=10.0
PRICE_FRESHNESS_MAX_S=10.0
HUD_REFRESH_SECONDS=3
DB_NAME=quantum.db

# V1.3.1 — HUD adaptativo journalctl/systemd.
#   auto (default): tty si stdout es terminal, log si está pipeado (systemd/journalctl)
#   tty           : siempre rich Live layout (clear+repaint cada HUD_REFRESH_SECONDS)
#   log           : snapshots plain-text greppables con prefijo [HUD], sin escapes ANSI
# En systemd: dejar HUD_MODE=auto y consultar con `journalctl -u quantum -f`.
HUD_MODE=auto
HUD_LOG_INTERVAL_SECONDS=60

# Modo LIQUIDATE_ONLY: bot opera solo BTC/ETH para entradas nuevas.
# Altcoins existentes se gestionan con OmniRisk (Ratchet + Moonbag + Stop sectorial)
# hasta liquidarse. Ningún motor de entrada toca altcoins. SE RECOMIENDA true en V1.
LIQUIDATE_ONLY=true

# Universo de entrada del Grid (Subsistema C). CSV de pares spot OKX para NUEVAS compras.
# Default (sin esta línea) = solo BTC/ETH (idéntico al comportamiento previo). BTC/ETH (core)
# SIEMPRE están, aunque no los listes. Agregar un par (ej. SOL/USDT) reabre entrada QUIRÚRGICA
# en ese alt como base-hold ACTIVE — el resto de alts sigue en LIQUIDATE_ONLY. Distinto (y más
# seguro) que LIQUIDATE_ONLY=false, que reabre TODAS las alts. Vetá liquidez/datos OKX antes.
# OKX_PARES_SPOT=BTC/USDT,ETH/USDT,SOL/USDT

# Timeout mutex por símbolo (motores spot compitiendo por mismo par)
ENTRY_LOCK_TIMEOUT_MS=50

# -----------------------------------------------------------------------------
# AUDITORÍA 6 BOTS OKX — features extraídos
# (okx_completo, okx_antiguo, okx_anterior, okx_dca, okx_gemini, okx_gigante)
# -----------------------------------------------------------------------------
# Pánico Global BTC (okx_dca V12): bloquea aperturas BTC/ETH spot + LONG fut
# si BTC cae PANIC_DROP_PCT en la última hora. Dura PANIC_BLOCK_MINUTES.
PANIC_DROP_PCT=3.0
PANIC_BLOCK_MINUTES=30

# DCA rebote confirmado (okx_dca V12): anti-cuchillo-cayendo. EscudoDCA exige
# DCA_REBOUND_PCT desde local_bottom antes de comprar (L1/L2/L3). L1 además
# mantiene su filtro original RSI≥35 + vela verde.
DCA_REBOUND_PCT=1.0

# Trailing drop adicional (okx_dca V12): OmniRisk dispara SELL si pnl retrocede
# TRAILING_DROP_PCT desde local_top (refuerza el trail de vagones).
TRAILING_DROP_PCT=2.0

# Anti-asfixia BE (okx_gemini V11.5): floor mínimo en tier 0 del Quantum Ratchet
# para que las fees no asfixien una salida en break-even puro.
BE_SAFETY_BUFFER_PCT=0.2

# Bóveda automática (okx_gemini V11.5): GestorTesoreria barre PnL realizado
# positivo del último ciclo a Funding USDT (no Earn, preserva rescate inmediato).
# Solo aplica a OKX (BIN no tiene GestorTesoreria).
VAULT_PNL_THRESHOLD_USDT=0.10
VAULT_PNL_FRAC=1.0

# -----------------------------------------------------------------------------
# AUDITORÍA BINANCE_ANTIGUO + KUCOIN_ANTIGUO (V1.2)
# -----------------------------------------------------------------------------
# TP Parcial 50% (kucoin_antiguo V13): SOLO BTC/ETH. Vende 50% al alcanzar
# TP_PARCIAL_PCT, asegura ganancia, deja runner con tp_armed tier=0 +
# floor=BE_SAFETY_BUFFER_PCT (free ride). Complementa Moonbag/Ratchet/Harvest.
TP_PARCIAL_PCT=1.5

# Killswitch volatilidad per-pair (binance_antiguo V14): bloquea aperturas si
# ATR_actual > VOL_SPIKE_MULT × SMA(ATR_14, VOL_SPIKE_WINDOW).
# V1.4.0: aplica solo a EscuadronGridBin/Okx (BUY maker) — MartilloEliteFut removido.
VOL_SPIKE_MULT=3.0
VOL_SPIKE_WINDOW=50

# V1.4.0 REMOVIDOS (estaban acá en V1.3.x):
# - FUT_TTL_HOURS / FUT_TTL_MIN_PNL_PCT (TTL Guillotina FUT, OmniRiskFut removido)
# - FUT_LOSS_COOLDOWN_MIN (cooldown post-pérdida FUT, CentinelaFut removido)

# -----------------------------------------------------------------------------
# V1.4.1 — MEJORAS ESTRATEGIAS Y ESCUADRONES (opt-in, defaults conservadores)
# -----------------------------------------------------------------------------
# Mejora #1: OBI gate para Grid BUY maker (defensa contra entry en presión vendedora).
# Antes de colocar el limit buy, lee orderbook spot vía REST y descarta si OBI ≤ MIN.
# OBI = (bid_vol - ask_vol) / total_vol ∈ [-1, +1]. Negativo = vendedores dominan.
# Default false (Grid maker pasivo no necesita esto; activar si ves muchos BUY
# que llenan y luego stop-out por movimiento adverso inmediato).
GRID_OBI_GATE_ENABLED=false
GRID_OBI_MIN=-0.20

# Mejora #2: Harvest tiers adaptativos según ATR diario%.
# Tiers base HARVEST_TIERS [2,4,7,11,16] se escalan por factor según volatilidad:
#   ATR ≥ HIGH_PCT → tiers × HIGH_MULT (vol alta: tiers más espaciados)
#   ATR ≤ LOW_PCT  → tiers × LOW_MULT  (vol baja: tiers más cercanos)
#   entre ambos    → interpolación lineal del multiplier
HARVEST_ATR_ADAPTIVE=true
HARVEST_ATR_HIGH_PCT=4.0
HARVEST_ATR_LOW_PCT=1.0
HARVEST_HIGH_MULT=1.4
HARVEST_LOW_MULT=0.75

# Mejora #3: Cooldown dinámico por símbolo según ATR diario%.
# cd_efectivo = base_cd × clamp(0.5 + atr_pct × 0.3, 0.5, 2.0)
# Vol alta espacia entradas, vol baja permite más frecuencia. Aplica a Grid BUY.
COOLDOWN_ATR_ADAPTIVE=true

# Mejora #4: Métricas yield/APY por motor (sin flag, siempre activo).
# RadarTelemetria._yield_metrics() agrega últimos 7 días de pnl realizado por
# fuente: spot_bin, spot_okx, arb, earn_est. HUD muestra línea resumen.

# Mejora #5: Dashboard spot vs HODL (usa OKX_BOT_GENESIS_* como baseline).
# Compara equity actual vs valor hipotético si hubieras comprado y HODL al genesis.
# Requiere OKX_BOT_GENESIS_TS, _CAPITAL, _BTC, _ETH seteados con valores reales.
HODL_DASHBOARD_ENABLED=true

# -----------------------------------------------------------------------------
# ML SIZING V1.5.0 — modulador de tamaño en Grid BUY (sin SL forzado)
# -----------------------------------------------------------------------------
# El modelo xgboost_oracle.joblib predice prob(precio toca +1.2% antes de -2%
# en 24 velas 15m). Esa prob modula CUÁNTO comprar dentro del rango
# [MIN_MULT, MAX_MULT]. Los gates técnicos del Grid (ADX<20, close>EMA200,
# no BAJISTA, no panic, no vol_spike, no OBI hostil) son veto previo obligatorio
# — ML nunca decide solo apertura ni cierre.
#
# Mapeo:
#   prob < MIN_PROB_FLOOR → mult = MIN_MULT (reduce, NUNCA skip)
#   prob = 1.0            → mult = MAX_MULT
#   entre ambos           → interpolación lineal
#
# Fail-safe: si modelo no carga o features no disponibles → mult = 1.0
# (comportamiento V1.4.3 baseline, transparente al motor llamador).
#
# Dataset: entrenar.py (mining histórico OHLCV). Reentrenar periódicamente:
#   python entrenar.py --dias 90
# El bot detecta el nuevo .joblib por mtime y lo hot-reloadea sin reiniciar.
# V1.8.3: NEUTRALIZADO (AUC walk-forward 0.495 = ruido). off → mult=1.0. Revivir SOLO con señal real.
ML_SIZING_ENABLED=false
ML_MIN_PROB_FLOOR=0.40
ML_MIN_MULT=0.40
ML_MAX_MULT=1.60

# -----------------------------------------------------------------------------
# BINANCE SPOT — REAL, siempre activo, BTC/ETH only para nuevas entradas
# -----------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

BIN_SPOT_MAX_CAP_USDT=60.0
BIN_GLOBAL_MAX_CAP_USDT=250.0
BIN_INVESTMENT_PCT=0.05
BIN_MOONBAG_TRIGGER=4.0
BIN_COOLDOWN_SECONDS=3600
BIN_DCA_MAX_COUNT=3
BIN_WAGON_TRAIL_FRAC=0.40
BIN_WAGON_TRAIL_MIN=0.25
# V1.4.0: ML único xgboost_oracle.joblib YA NO se consume (MartilloEliteFut removido).
# Se mantiene la carga del modelo por compatibilidad; reintroducible en V2 con un
# nuevo motor que respete la filosofía sin SL forzado.

# V1.3.4 — GestorInventarioBin (Simple Earn Flexible cripto, espejo OKX).
# Parquea cripto idle del portfolio BIN (BTC/ETH/alts) en Simple Earn Flexible.
# Subscribe/redeem vía ccxt sapi. Redeem FAST = T+0 (síncrono pre-SELL).
# BIN flujo Spot ↔ Earn directo (no requiere Funding bucket como OKX).
# AIMD confidence ∈ [0.30, 1.00], +0.05 cada SUCCESS_STEP, /2 + freeze 24h en fallo.
# Cache productId por asset al primer uso (BIN Earn requiere productId, no solo ticker).
# Si ccy no tiene producto Earn (códigos -6001/-6010/-6024) → cache unsupported.
BIN_INV_INCLUYE_ALTS=true
BIN_INV_YIELD_MIN_USD_CYCLE=0.01
BIN_INV_YIELD_INITIAL_CONF=0.30
BIN_INV_YIELD_SUCCESS_STEP=10
BIN_INV_YIELD_FLUSH_TIMEOUT=60
BIN_INV_YIELD_FREEZE_SECS=86400

# -----------------------------------------------------------------------------
# BINANCE FUTUROS — V1.4.0: SOLO ARB PERP LEG (delta-neutral, sin SL forzado).
# Directional FUT (LONG/SHORT) eliminado en V1.4.0. ARB usa estos credenciales
# para el short perp leg; el SHORT está balanceado contra LONG spot, no es bet
# direccional, no requiere stop-loss.
# -----------------------------------------------------------------------------
FUTUROS_HABILITADO=false
FUT_SANDBOX=true

BINANCE_FUT_API_KEY=
BINANCE_FUT_API_SECRET=

# -----------------------------------------------------------------------------
# V1.2.10 — SUBCUENTA BINANCE DEDICADA PARA ARB (opcional pero recomendado)
# Si seteadas: ArbExecutor crea clientes spot+fut AISLADOS con estas keys.
# Si vacías: ARB cae al fallback (BINANCE_API_KEY + BINANCE_FUT_API_KEY del main).
# Requisitos en la subcuenta: permisos Reading + Spot/Margin + Futures (sin withdrawals),
# IP whitelist del VPS, capital USDT cargado.
# -----------------------------------------------------------------------------
BINANCE_ARB_API_KEY=
BINANCE_ARB_API_SECRET=

FUT_SIMBOLOS=["BTC/USDT:USDT","ETH/USDT:USDT"]
FUT_LEVERAGE=2
FUT_MAX_NOTIONAL_PER_SYM=50.0
FUT_MAX_NOTIONAL_GLOBAL=100.0
FUT_MARGIN_PCT=0.10

# V1.4.0 REMOVIDOS de .env (estaban acá en V1.3.x):
# - FUT_STOP_LOSS_PCT, FUT_NATIVE_STOP_BUFFER_PCT  → stop nativo deadman
# - FUT_SL_K_ATR, FUT_SL_MIN_PCT, FUT_SL_MAX_PCT, FUT_SL_FAST_TRACK_MULT → SL dinámico
# - FUT_MAX_RISK_PER_TRADE_PCT → sizing por riesgo (MartilloElite)
# - FUT_MOONBAG_TRIGGER → moonbag FUT (OmniRiskFut)
# - FUT_DCA_MAX_COUNT, FUT_DCA_L1_PCT, FUT_DCA_L2_PCT → EscudoDCAFut
# - FUT_COOLDOWN_SECONDS → cooldown MartilloElite
# - FUT_WAGON_TRAIL_FRAC, FUT_WAGON_TRAIL_MIN → Quantum Ratchet FUT
# - FUT_ML_MIN_CONFIDENCE → gate ML MartilloElite (V2 puede reintroducirlo)
# - RADAR_BALLENA_ENABLED, RADAR_OBI_UMBRAL, RADAR_PNL_TRIGGER_PCT,
#   RADAR_CONFIRMACIONES, RADAR_TICK_SECONDS → RadarAntiballena V1.3.2 (FUT)
# Si los tenés en tu .env personal, podés borrarlos — el bot los ignora.

# -----------------------------------------------------------------------------
# OKX SPOT — REAL, siempre activo, BTC/ETH only para nuevas entradas
# -----------------------------------------------------------------------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

OKX_SPOT_MAX_CAP_USDT=500.0
OKX_GLOBAL_MAX_CAP_USDT=2500.0
OKX_INVESTMENT_PCT=0.04
OKX_MOONBAG_TRIGGER=4.0
OKX_COOLDOWN_SECONDS=3600
OKX_DCA_MAX_COUNT=3
# Nota: V1 spot OKX no usa ML (mismo razonamiento que BIN)

# V1.8.2 — Resiliencia anti-bot/Cloudflare (los 403 transitorios de OKX). Default ON.
# okx_retry: backoff exponencial + jitter ante 403/Cloudflare/DDoS/timeout en los reads.
# Espera total acotada (intentos × max_s) para no colgar MotorIndicadores.
OKX_RETRY_INTENTOS=3
OKX_RETRY_BASE_S=1.0
OKX_RETRY_MAX_S=6.0
# UA de navegador + Accept-Language + timeout holgado → Cloudflare challenguea menos.
OKX_ANTIBOT_UA=true

# --- Ladder Grid SP3 (EscuadronLadderOkx) — sleeve spot round-trip, canary. Default OFF. ---
LADDER_ENABLED=false            # true = enciende el sleeve ladder (decisión explícita + deploy)
LADDER_CANARY_MODE=true         # true = lote mínimo, mide fill-real vs fill-ideal antes de escalar
LADDER_PARES=LTC/USDT           # universo del sleeve (cosecha más limpia en SP2). NO toca BTC/ETH grid core
LADDER_MAX_CAPITAL=100          # envelope de capital (USDT) POR PAR. validar_config aborta si
                               # cap x n_pares > 500 totales: con 6 pares, 100 ya aborta ($600).
LADDER_RUNGS=4                  # rungs de compra en la escalera
LADDER_SPACING_PCT=1.5          # spacing entre rungs y del round-trip (%)
LADDER_STOP_PCT=15              # stop a rung colgado underwater (%)
LADDER_DAILY_LOSS_CAP=15        # cap de pérdida diaria (USDT) → congela el sleeve
LADDER_TICK_S=60               # período del loop (s)

# GestorTesoreria (Earn USDT)
OKX_SAVINGS_APR_REF=0.05

# GestorInventario (Earn cripto — V1 solo BTC y ETH; altcoins en LIQUIDATE_ONLY no se parquean)
OKX_INV_YIELD_MIN_USD_CYCLE=0.01
OKX_INV_YIELD_INITIAL_CONF=0.30
OKX_INV_YIELD_SUCCESS_STEP=10
# Timeout subido de 30→60s para mitigar race con OmniRisk SELL (auditoría)
OKX_INV_YIELD_FLUSH_TIMEOUT=60
OKX_INV_YIELD_FREEZE_SECS=86400

# V1.3.3 — extiende GestorInventario a alts del portfolio OKX (LIQUIDATE_ONLY).
# true (default V1.3.3) → parquea TODO el portfolio activo en OKX Earn cripto:
#   BTC/ETH + alts (SUI/SOL/UNI/ADA/AVAX/LINK/etc según portfolio real).
#   Las alts en LIQUIDATE_ONLY generan yield mientras esperan recovery o salida.
# false → solo BTC/ETH (comportamiento V1.0).
# flush_to_spot SÍNCRONO pre-SELL es agnóstico al asset: cuando OmniRisk dispara
# SELL en una alt parqueada, redime primero y vende después (cierre defensivo
# heredado de okx_gemini V11.5 + invalidate_balance + verificación qty real).
# Si OKX rechaza purchase de un ccy (códigos 58001/58002/51000), entra a cache
# unsupported (RAM) y futuros ciclos lo saltan. Reconciliación 24h adopta qty
# huérfana del Earn que el bot no parqueó.
OKX_INV_INCLUYE_ALTS=true

# Bot Genesis (HUD benchmark vs HODL)
OKX_BOT_GENESIS_TS=0.0
OKX_BOT_GENESIS_CAPITAL=0.0
OKX_BOT_GENESIS_BTC=0.0
OKX_BOT_GENESIS_ETH=0.0

# -----------------------------------------------------------------------------
# FUNDING ARB — default SHADOW. V1: solo INTRA-exchange.
# Cross-venue (long spot BIN + short perp OKX) requiere bridge USDT → V2.
# Para promover a LIVE: ARB_LIVE=true + (recomendado) usar API keys de subcuenta dedicada.
# -----------------------------------------------------------------------------
ARB_LIVE=false
ARB_PARES=["BTC","ETH"]
ARB_VENUES=["binance","okx"]
ARB_INTRA_VENUE=binance
ARB_CAPITAL_USDT=100.0
ARB_CAPITAL_USAGE=0.95

ARB_MA_WINDOW=21
ARB_ENTRY_THR=0.00002
ARB_EXIT_THR=-0.00001
ARB_MIN_HOLD_CYCLES=6

ARB_CATALYST_SCORE_THR=0.5
ARB_CATALYST_SIGNAL_PATH=catalyst_signal.json
ARB_DEEP_FLOOR=-0.0008
ARB_MA_PROXIMITY=0.00001

ARB_SCAN_INTERVAL_SECONDS=300

# Fees (modelables; defaults conservadores)
ARB_FEE_SPOT=0.001
ARB_FEE_PERP=0.0004
ARB_BASIS_SLIPPAGE=0.0002

# V1.2.8 ARB fix #3: gate funding mínimo al entrar (short-perp gana si funding>0).
# 0.0 = strict (solo entra con funding actual positivo, recomendado).
# Subir para más conservador (ej. 0.00005 = ~0.55% APY mínimo esperado).
# Bajar a negativo si querés permitir catalyst con funding negativo esperando revert.
ARB_MIN_FUNDING_ENTRY=0.0

# V1.2.9: 4 fixes medios pre-LIVE serio.
# max_hold: si pos lleva N cycles sin EXIT signal y basis razonable, exit forzado
# para liberar capital. 30 cycles = 10 días con 8h cycles.
ARB_MAX_HOLD_CYCLES=30

# Gate liquidez orderbook: depth bid+ask debe ser ≥ N × capital. 3.0 = sano.
# Subir para más conservador (5.0) o bajar a 1.5 si el par tiene poca depth.
ARB_LIQUIDITY_MIN_MULT=3.0

# Spread bid-ask máximo aceptable (% del precio). 0.1% = típico BTC/ETH BIN/OKX.
# Subir si tu par tiene spread más amplio (memes, low-cap).
ARB_MAX_SPREAD_PCT=0.1

# =============================================================================
# PATA BAJISTA V1.7.0 (EscuadronShortOkx) — futuros OKX direccional disciplinado
# Reabre futuros CONSCIENTEMENTE (revierte el "no futuros" de V1.6.0) con riesgo
# acotado: leverage bajo + margen isolated + stop server-side + gate de régimen.
# Solo opera en régimen BAJISTA. Primer despliegue real → ver canary_short.md.
# =============================================================================
OKX_FUT_ENABLED=false          # true para activar la pata bajista
SHORT_MAX_EQUITY_PCT=0.18      # máx % del equity en la pata (resto en earn)
SHORT_LEVERAGE=3               # apalancamiento (validación: rango seguro 1-5)
SHORT_SL_PCT=0.04              # stop-loss server-side, % sobre el precio de entrada
SHORT_TP_PCT=0.03              # take-profit server-side (OCO con el SL): cierra al -3% de precio
SHORT_MAX_POSICIONES=2         # posiciones short simultáneas máx
SHORT_DAILY_LOSS_CAP_USD=60    # circuit breaker: corta entradas si pérdida diaria supera esto
SHORT_CANARY_MODE=true         # true = lote mínimo + 1 posición hasta verificar isolated+SL
# Umbrales de senal_short (env-configurables tras el barredor 2026-06-16). RSI55→14 trades/año
# (insuficiente p/ shadow); RSI52→74 (mejor frecuencia+calidad). DI-on SIRVE (no apagar). Bajá a 52
# para re-backfillear y medir si las políticas dinámicas dan vuelta el baseline perdedor.
SHORT_RSI_MIN=55               # rebote (RSI elevado). 52 = más frecuencia con calidad similar
SHORT_ADX_MIN=20               # hay tendencia, no chop
SHORT_DI_FILTER=true           # filtro −DI≥+DI: el barredor confirmó que filtra entradas malas

# --- Gestor de Salida SHADOW (Fase 1, multiverso de MEDICIÓN — riesgo cero) ---
# Mide en paper varias políticas de salida del short sobre entradas virtuales. NO toca
# capital ni órdenes. Corre aunque OKX_FUT_ENABLED=false. Ver gestor_salida_shadow_spec.md.
SHORT_SHADOW_ENABLED=true       # hilo de medición siempre on (riesgo cero); false lo apaga
SHORT_SHADOW_CHANDELIER_K=2.5   # múltiplo de ATR del trailing chandelier ("cabalga el cuchillo")
SHORT_SHADOW_ML_ADVERSO=0.60    # umbral ml_prob (ML long invertido) para salida adversa
SHORT_SHADOW_MAX_HOLD_S=21600   # cierre forzado de virtuales tras 6h (24 velas 15m)

# --- Gestor de Salida Fase 2: gradúa la política ganadora del shadow a capital REAL ---
# shadow (default) = sin gestión dinámica (el OCO server-side gobierna; cero cambio).
# live = auto-selecciona la mejor política graduada del shadow. <nombre> = pin manual
# (oco_fijo|chandelier|momentum|ml_adverso). El SL server-side queda de piso bajo todo.
# NO girar a live/pin sin revisar que short_shadow_resumen() tenga muestra suficiente.
SHORT_GESTOR_MODE=shadow        # shadow | live | meta | oco_fijo | chandelier | momentum | ml_adverso
SHORT_GESTOR_MIN_TRADES=30      # muestras mín. por política para graduarla (live y meta)
SHORT_GESTOR_MARGEN_PCT=0.2     # la ganadora debe superar a oco_fijo por ≥ esto en pnl_avg (puntos %)

# --- Fase 3: meta-learner online (modo SHORT_GESTOR_MODE=meta) ---
# Selecciona la política por CONTEXTO de volatilidad (calmo/normal/picado) y ponderada por
# RECENCIA. Distinta maniobra por tamaño de ola; se adapta cuando el mar cambia.
SHORT_META_HALFLIFE_S=604800    # half-life del peso por recencia (7d): lo viejo pesa menos
SHORT_META_VOL_LOW=0.005        # ATR/close < 0.5% = mar calmo
SHORT_META_VOL_HIGH=0.015       # ATR/close > 1.5% = mar picado (entre medio = normal)
SHORT_META_GATE=apareado        # apareado (t-pareado+n efectivo+LCB, recomendado) | margen (simple)
SHORT_META_Z=1.65               # z de la cota inferior de confianza (1.65 = 95% una cola)

# --- Funding como contexto del meta (Punto C) — señal nueva que puede SUBIR edge ---
# Opt-in: default off = contexto solo por volatilidad. Backfillable (entrenar.py --shadow-backfill
# lo siembra). Live: MotorIndicadores refresca el funding de los perps cuando está on.
SHORT_FUNDING_CONTEXT=false     # true = contexto = volatilidad × funding (neg/neutro/pos)
SHORT_FUNDING_THR=0.0005        # ±0.05%/8h = funding "extremo" (neg=shorts amontonados=squeeze risk)

# --- Funding como 6ª feature del ML (Punto A) — beneficia sobre todo al Grid-long ---
# OJO: cambiar este flag INVALIDA el modelo vigente (5 features) → hay que REENTRENAR junto:
#   1) poné ML_FUNDING_FEATURE=true  2) borrá/renombrá la DB o ml_feature_log (re-mine limpio)
#   3) python entrenar.py  → genera modelo de 6 features. Si no coincide, ml_predict_prob falla
#   defensivo (→ None → mult 1.0 / ml_adverso solo-SL). Default false = modelo actual intacto.
ML_FUNDING_FEATURE=false

# --- Auto-entrenamiento: main.py llama a entrenar.py periódicamente (mapa ML fresco) ---
ENTRENAR_AUTO_ENABLED=true      # hilo que re-entrena el ML por subproceso cada N horas
ENTRENAR_INTERVALO_H=24         # cada cuántas horas re-entrena
ENTRENAR_DIAS=90                # ventana de histórico a minar
ENTRENAR_AUTO_BACKFILL=false    # además backfillea el shadow (replay histórico) en cada ciclo
